# NITC Resource Vault
# Copy to .env for local development. NEVER commit real secrets.

APP_ENV=development
APP_ADDR=:8080
APP_BASE_URL=http://localhost:8080

# PostgreSQL
DATABASE_URL=postgres://archive:archive@postgres:5432/archive?sslmode=disable
POSTGRES_USER=archive
POSTGRES_PASSWORD=archive
POSTGRES_DB=archive

# Session security: use a long random value in production.
SESSION_SECRET=dev-secret-change-in-production-min-32-chars

# Local development storage only. Production published PDFs use Internet Archive.
STORAGE_DIR=./data/storage
MAX_UPLOAD_MB=25
LOG_LEVEL=info

# Google OAuth / OIDC
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://localhost:8080/auth/google/callback
GOOGLE_HOSTED_DOMAIN=nitc.ac.in

# Internet Archive
# Production must not silently fall back to local storage when these are missing.
IA_ACCESS_KEY=
IA_SECRET_KEY=
IA_COLLECTION=
IA_IDENTIFIER_PREFIX=nitc-resource-vault
