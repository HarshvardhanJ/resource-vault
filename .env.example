# Application Configuration
APP_ENV=development
APP_ADDR=:8080
APP_BASE_URL=http://localhost:8080

# Database Configuration
DATABASE_URL=postgres://archive:archive@postgres:5432/archive?sslmode=disable
POSTGRES_USER=archive
POSTGRES_PASSWORD=archive
POSTGRES_DB=archive

# Session Security (minimum 32 random characters in production)
SESSION_SECRET=dev-secret-change-in-production-min-32-chars

# Local Storage Directory
STORAGE_DIR=./data/storage

# Upload Constraints
MAX_UPLOAD_MB=25

# Logging
LOG_LEVEL=info

# Google OAuth / OIDC (Phase 2)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://localhost:8080/auth/google/callback
GOOGLE_HOSTED_DOMAIN=nitc.ac.in

# Internet Archive Credentials (Phase 4)
IA_ACCESS_KEY=
IA_SECRET_KEY=
IA_COLLECTION=
IA_IDENTIFIER_PREFIX=nitc-pyq
